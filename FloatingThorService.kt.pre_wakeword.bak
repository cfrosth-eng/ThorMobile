package com.example.thormobile

import android.Manifest
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.content.pm.ServiceInfo
import android.graphics.PixelFormat
import android.media.AudioAttributes
import android.media.AudioFormat
import android.media.AudioManager
import android.media.AudioRecord
import android.media.AudioTrack
import android.media.MediaRecorder
import android.media.audiofx.AcousticEchoCanceler
import android.media.audiofx.AudioEffect
import android.os.Build
import android.os.Handler
import android.os.IBinder
import android.os.Looper
import android.os.Process
import android.util.Log
import android.view.Gravity
import android.view.LayoutInflater
import android.view.MotionEvent
import android.view.View
import android.view.WindowManager
import android.widget.Toast
import androidx.core.app.NotificationCompat
import androidx.core.content.ContextCompat
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.Response
import okhttp3.WebSocket
import okhttp3.WebSocketListener
import okio.ByteString
import okio.ByteString.Companion.toByteString
import java.util.concurrent.LinkedBlockingQueue
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicInteger
import kotlin.math.abs
import kotlin.math.min

/**
 * Edge client for Project Thor.
 *
 * One continuous, full-duplex WebSocket to the Gemini Live Bridge (gemini_live_bridge.py):
 *   up   : raw 16 kHz mono PCM16 from the mic (VOICE_COMMUNICATION + AcousticEchoCanceler), binary frames
 *   down : raw 24 kHz mono PCM16 (Gemini Live's native output rate) played through an AudioTrack
 *   flush: a binary frame that is exactly 0xDEADBEEF means "operator barged in" -> drop all queued/buffered playback
 *
 * There is no HTTP upload / polling path in this client.
 */
class FloatingThorService : Service() {

    companion object {
        private const val TAG_AUDIO = "ThorAudio"
        private const val TAG_WS = "ThorWebSocket"

        // LOCAL TESTING: laptop Wi-Fi IPv4 (phone must be on the same network). The bridge
        // (gemini_live_bridge.py) listens on ws://0.0.0.0:8080 by default (THOR_BRIDGE_PORT). Plain ws:// is permitted
        // by android:usesCleartextTraffic="true" in the manifest. Update the IP if the laptop's DHCP lease changes.
        private const val BRIDGE_URL = "ws://10.207.195.214:8080"

        // Upstream (mic -> bridge -> Gemini): the bridge forwards this as "audio/pcm;rate=16000".
        private const val CAPTURE_SAMPLE_RATE = 16000
        private const val CAPTURE_FRAME_BYTES = 1600 // 50 ms of 16 kHz mono PCM16

        // Downstream (Gemini -> bridge -> speaker): Gemini Live emits 24 kHz PCM16.
        private const val PLAYBACK_SAMPLE_RATE = 24000
        private const val PLAYBACK_SLICE_BYTES = 1920 // 40 ms; bounds how much stale audio is written after a flush

        // Real-time audio: if the uplink backs up, drop mic frames instead of building seconds of latency.
        private const val MAX_SEND_QUEUE_BYTES = 128L * 1024L

        // Barge-in flush marker sent by the bridge as its own 4-byte binary WebSocket frame.
        private val FLUSH_MARKER: ByteString =
            byteArrayOf(0xDE.toByte(), 0xAD.toByte(), 0xBE.toByte(), 0xEF.toByte()).toByteString()
    }

    private class PcmChunk(val generation: Int, val data: ByteArray)

    private lateinit var windowManager: WindowManager
    private lateinit var floatingView: View
    private lateinit var audioManager: AudioManager
    private val mainHandler = Handler(Looper.getMainLooper())

    private val lock = Any()

    // 0 = idle; otherwise the id of the live session. Callbacks from older sessions compare against this and bail.
    @Volatile private var activeSession = 0
    private val sessionSeq = AtomicInteger(0)

    private var webSocket: WebSocket? = null
    private val okHttpClient: OkHttpClient by lazy {
        OkHttpClient.Builder()
            .readTimeout(0, TimeUnit.MILLISECONDS)
            .writeTimeout(0, TimeUnit.MILLISECONDS)
            .pingInterval(20, TimeUnit.SECONDS) // keeps the continuous connection alive through proxies/tunnels
            .build()
    }

    // Capture
    private var audioRecord: AudioRecord? = null
    private var echoCanceler: AcousticEchoCanceler? = null
    private var recordingThread: Thread? = null

    // Playback
    private var audioTrack: AudioTrack? = null
    private var playbackThread: Thread? = null
    private val playbackQueue = LinkedBlockingQueue<PcmChunk>()
    private val flushGeneration = AtomicInteger(0)
    @Volatile private var isPlayingAudio = false

    override fun onCreate() {
        super.onCreate()

        audioManager = getSystemService(Context.AUDIO_SERVICE) as AudioManager

        createNotificationChannel()
        val notification = NotificationCompat.Builder(this, "ThorChannelId")
            .setContentTitle("Vanguard Online")
            .setContentText("Tap to connect. Tap to disconnect.")
            .setSmallIcon(R.mipmap.ic_launcher)
            .build()

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            startForeground(1, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
        } else {
            startForeground(1, notification)
        }

        windowManager = getSystemService(WINDOW_SERVICE) as WindowManager
        floatingView = LayoutInflater.from(this).inflate(R.layout.layout_floating_thor, null)

        val layoutFlag: Int = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
        } else {
            @Suppress("DEPRECATION")
            WindowManager.LayoutParams.TYPE_PHONE
        }

        val params = WindowManager.LayoutParams(
            WindowManager.LayoutParams.WRAP_CONTENT,
            WindowManager.LayoutParams.WRAP_CONTENT,
            layoutFlag,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
            PixelFormat.TRANSLUCENT
        )

        params.gravity = Gravity.TOP or Gravity.START
        params.x = 0
        params.y = 100

        windowManager.addView(floatingView, params)

        var initialX = 0
        var initialY = 0
        var initialTouchX = 0f
        var initialTouchY = 0f
        var isDragging = false

        floatingView.setOnTouchListener { _, event ->
            when (event.action) {
                MotionEvent.ACTION_DOWN -> {
                    initialX = params.x
                    initialY = params.y
                    initialTouchX = event.rawX
                    initialTouchY = event.rawY
                    isDragging = false
                    true
                }
                MotionEvent.ACTION_MOVE -> {
                    val dx = event.rawX - initialTouchX
                    val dy = event.rawY - initialTouchY

                    if (abs(dx) > 10 || abs(dy) > 10) {
                        isDragging = true
                    }

                    params.x = initialX + dx.toInt()
                    params.y = initialY + dy.toInt()
                    windowManager.updateViewLayout(floatingView, params)
                    true
                }
                MotionEvent.ACTION_UP -> {
                    if (!isDragging) {
                        handleOverlayTap()
                    }
                    true
                }
                else -> false
            }
        }
    }

    private fun handleOverlayTap() {
        if (activeSession != 0) {
            stopStreamingAudio()
            toast("Disconnected from Vanguard.")
        } else {
            if (ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED) {
                toast("Connecting to Vanguard...")
                startStreamingAudio()
            } else {
                toast("Microphone permission required")
            }
        }
    }

    private fun toast(message: String) {
        mainHandler.post { Toast.makeText(this, message, Toast.LENGTH_SHORT).show() }
    }

    // ---------------------------------------------------------------------------------------------
    // Session lifecycle
    // ---------------------------------------------------------------------------------------------

    private fun startStreamingAudio() {
        synchronized(lock) {
            if (activeSession != 0) return

            enterCommunicationMode()

            val record = createAudioRecord()
            if (record == null) {
                exitCommunicationMode()
                toast("Microphone failed to initialize.")
                return
            }
            audioRecord = record
            echoCanceler = attachEchoCanceler(record)

            startPlayback()

            val id = sessionSeq.incrementAndGet()
            activeSession = id

            val request = Request.Builder()
                .url(BRIDGE_URL)
                .addHeader("ngrok-skip-browser-warning", "true")
                .build()
            webSocket = okHttpClient.newWebSocket(request, BridgeListener(id))
        }
    }

    /** Idempotent. Safe to call from the UI thread, the OkHttp threads and the capture thread. */
    private fun stopStreamingAudio() {
        var socketToClose: WebSocket? = null
        synchronized(lock) {
            if (activeSession == 0) return
            activeSession = 0

            socketToClose = webSocket
            webSocket = null

            val record = audioRecord
            val aec = echoCanceler
            audioRecord = null
            echoCanceler = null
            // A running capture thread owns the recorder and releases it when it sees the session end.
            // If the socket never opened, nobody owns it, so release it here.
            if (recordingThread == null) {
                releaseCapture(record, aec)
            }
            recordingThread = null

            stopPlayback()
            exitCommunicationMode()
        }
        socketToClose?.close(1000, "Client disconnect")
    }

    private inner class BridgeListener(private val sessionId: Int) : WebSocketListener() {

        override fun onOpen(ws: WebSocket, response: Response) {
            if (sessionId != activeSession) {
                ws.close(1000, "Stale session")
                return
            }
            Log.d(TAG_WS, "WebSocket connected.")
            startCaptureThread(sessionId, ws)
        }

        override fun onMessage(ws: WebSocket, text: String) {
            Log.d(TAG_WS, "Text message from server: $text")
        }

        override fun onMessage(ws: WebSocket, bytes: ByteString) {
            if (sessionId != activeSession) return

            // The bridge sends the barge-in marker as its own 4-byte frame; WebSocket preserves frame
            // boundaries, so an exact match is safe and can never swallow real audio.
            if (bytes == FLUSH_MARKER) {
                Log.d(TAG_AUDIO, "0xDEADBEEF flush marker received - dumping playback buffer.")
                flushPlayback()
            } else {
                playbackQueue.add(PcmChunk(flushGeneration.get(), bytes.toByteArray()))
            }
        }

        override fun onClosing(ws: WebSocket, code: Int, reason: String) {
            Log.d(TAG_WS, "WebSocket closing: $code $reason")
            if (sessionId == activeSession) stopStreamingAudio()
        }

        override fun onClosed(ws: WebSocket, code: Int, reason: String) {
            Log.d(TAG_WS, "WebSocket closed: $reason")
            if (sessionId == activeSession) stopStreamingAudio()
        }

        override fun onFailure(ws: WebSocket, t: Throwable, response: Response?) {
            Log.e(TAG_WS, "Connection failed", t)
            if (sessionId == activeSession) {
                stopStreamingAudio()
                toast("Connection to Vanguard lost.")
            }
        }
    }

    // ---------------------------------------------------------------------------------------------
    // Capture: 16 kHz mono PCM16, VOICE_COMMUNICATION source, AcousticEchoCanceler attached
    // ---------------------------------------------------------------------------------------------

    @Suppress("DEPRECATION")
    private fun enterCommunicationMode() {
        audioManager.mode = AudioManager.MODE_IN_COMMUNICATION
        audioManager.isSpeakerphoneOn = true
    }

    @Suppress("DEPRECATION")
    private fun exitCommunicationMode() {
        audioManager.mode = AudioManager.MODE_NORMAL
        audioManager.isSpeakerphoneOn = false
    }

    private fun createAudioRecord(): AudioRecord? {
        val minBuffer = AudioRecord.getMinBufferSize(
            CAPTURE_SAMPLE_RATE,
            AudioFormat.CHANNEL_IN_MONO,
            AudioFormat.ENCODING_PCM_16BIT
        )
        val bufferSize = if (minBuffer > 0) maxOf(minBuffer, CAPTURE_FRAME_BYTES * 4) else CAPTURE_FRAME_BYTES * 8

        val record = try {
            AudioRecord(
                MediaRecorder.AudioSource.VOICE_COMMUNICATION,
                CAPTURE_SAMPLE_RATE,
                AudioFormat.CHANNEL_IN_MONO,
                AudioFormat.ENCODING_PCM_16BIT,
                bufferSize
            )
        } catch (e: Exception) {
            Log.e(TAG_AUDIO, "AudioRecord construction failed.", e)
            return null
        }

        if (record.state != AudioRecord.STATE_INITIALIZED) {
            Log.e(TAG_AUDIO, "AudioRecord failed to initialize.")
            record.release()
            return null
        }
        return record
    }

    /** The returned effect must stay referenced for the life of the recorder, then be released. */
    private fun attachEchoCanceler(record: AudioRecord): AcousticEchoCanceler? {
        if (!AcousticEchoCanceler.isAvailable()) {
            Log.w(TAG_AUDIO, "AcousticEchoCanceler is NOT available on this device - loudspeaker feedback is possible.")
            toast("Echo cancellation unavailable on this device.")
            return null
        }
        val aec = AcousticEchoCanceler.create(record.audioSessionId)
        if (aec == null) {
            Log.w(TAG_AUDIO, "AcousticEchoCanceler.create() returned null.")
            toast("Echo cancellation could not be created.")
            return null
        }
        val status = aec.setEnabled(true)
        if (status != AudioEffect.SUCCESS || !aec.enabled) {
            Log.w(TAG_AUDIO, "AcousticEchoCanceler could not be enabled (status=$status).")
            aec.release()
            toast("Echo cancellation could not be enabled.")
            return null
        }
        Log.d(TAG_AUDIO, "Acoustic Echo Canceler engaged.")
        return aec
    }

    private fun startCaptureThread(sessionId: Int, ws: WebSocket) {
        synchronized(lock) {
            if (sessionId != activeSession) return
            val record = audioRecord ?: return
            val aec = echoCanceler

            val thread = Thread {
                Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_AUDIO)
                try {
                    record.startRecording()
                    if (record.recordingState != AudioRecord.RECORDSTATE_RECORDING) {
                        Log.e(TAG_AUDIO, "AudioRecord refused to start recording.")
                        return@Thread
                    }

                    val frame = ByteArray(CAPTURE_FRAME_BYTES)
                    while (sessionId == activeSession) {
                        val read = record.read(frame, 0, frame.size)
                        if (read < 0) {
                            Log.e(TAG_AUDIO, "AudioRecord.read error: $read")
                            break
                        }
                        if (read == 0) continue

                        if (ws.queueSize() > MAX_SEND_QUEUE_BYTES) {
                            continue // uplink congested; drop this frame to stay real-time
                        }
                        // Raw PCM16, exactly as captured. No local gating, no re-encoding.
                        ws.send(frame.toByteString(0, read))
                    }
                } catch (e: Exception) {
                    Log.e(TAG_AUDIO, "Capture loop failed.", e)
                } finally {
                    releaseCapture(record, aec)
                    // If we exited on our own (error), tear the session down; no-op if already stopped.
                    if (sessionId == activeSession) stopStreamingAudio()
                }
            }
            recordingThread = thread
            thread.start()
        }
    }

    private fun releaseCapture(record: AudioRecord?, aec: AcousticEchoCanceler?) {
        try {
            aec?.release()
        } catch (e: Exception) {
            Log.e(TAG_AUDIO, "Error releasing AcousticEchoCanceler", e)
        }
        try {
            if (record?.recordingState == AudioRecord.RECORDSTATE_RECORDING) record.stop()
        } catch (e: Exception) {
            Log.e(TAG_AUDIO, "Error stopping AudioRecord", e)
        }
        try {
            record?.release()
        } catch (e: Exception) {
            Log.e(TAG_AUDIO, "Error releasing AudioRecord", e)
        }
    }

    // ---------------------------------------------------------------------------------------------
    // Playback: 24 kHz mono PCM16 with instant barge-in flush
    // ---------------------------------------------------------------------------------------------

    private fun startPlayback() {
        playbackQueue.clear()

        val minBuffer = AudioTrack.getMinBufferSize(
            PLAYBACK_SAMPLE_RATE,
            AudioFormat.CHANNEL_OUT_MONO,
            AudioFormat.ENCODING_PCM_16BIT
        )
        val bufferSize = if (minBuffer > 0) minBuffer * 2 else PLAYBACK_SLICE_BYTES * 8

        val track = AudioTrack.Builder()
            .setAudioAttributes(
                AudioAttributes.Builder()
                    .setUsage(AudioAttributes.USAGE_VOICE_COMMUNICATION) // same stream the echo canceler references
                    .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
                    .build()
            )
            .setAudioFormat(
                AudioFormat.Builder()
                    .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                    .setSampleRate(PLAYBACK_SAMPLE_RATE)
                    .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
                    .build()
            )
            .setBufferSizeInBytes(bufferSize)
            .setTransferMode(AudioTrack.MODE_STREAM)
            .build()
        track.play()
        audioTrack = track

        isPlayingAudio = true
        val thread = Thread {
            Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_AUDIO)
            try {
                while (isPlayingAudio) {
                    val chunk = playbackQueue.poll(100, TimeUnit.MILLISECONDS) ?: continue
                    var offset = 0
                    // Write in small slices and re-check the flush generation, so a flush that lands mid-chunk
                    // stops us from pushing the rest of that (now stale) chunk into the AudioTrack.
                    while (offset < chunk.data.size && chunk.generation == flushGeneration.get()) {
                        val length = min(PLAYBACK_SLICE_BYTES, chunk.data.size - offset)
                        val written = track.write(chunk.data, offset, length)
                        if (written < 0) {
                            Log.e(TAG_AUDIO, "AudioTrack.write error: $written")
                            break
                        }
                        offset += written
                    }
                }
            } catch (e: InterruptedException) {
                // Normal shutdown.
            } catch (e: Exception) {
                Log.e(TAG_AUDIO, "Playback loop failed.", e)
            }
        }
        playbackThread = thread
        thread.start()
    }

    /** Barge-in: drop everything queued and everything already handed to the AudioTrack. */
    private fun flushPlayback() {
        flushGeneration.incrementAndGet() // invalidates queued chunks and any chunk mid-write
        playbackQueue.clear()
        val track = audioTrack ?: return
        try {
            track.pause()
            track.flush()
            track.play()
        } catch (e: Exception) {
            Log.e(TAG_AUDIO, "Error flushing AudioTrack after flush marker", e)
        }
    }

    private fun stopPlayback() {
        isPlayingAudio = false
        playbackThread?.interrupt()
        playbackThread = null

        flushGeneration.incrementAndGet()
        playbackQueue.clear()

        val track = audioTrack
        audioTrack = null
        if (track != null) {
            try {
                track.pause()
                track.flush()
            } catch (e: Exception) {
                Log.e(TAG_AUDIO, "Error silencing AudioTrack", e)
            }
            try {
                track.release()
            } catch (e: Exception) {
                Log.e(TAG_AUDIO, "Error releasing AudioTrack", e)
            }
        }
    }

    // ---------------------------------------------------------------------------------------------

    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                "ThorChannelId",
                "Thor Service Channel",
                NotificationManager.IMPORTANCE_LOW
            )
            val manager = getSystemService(NotificationManager::class.java)
            manager.createNotificationChannel(channel)
        }
    }

    override fun onBind(intent: Intent?): IBinder? = null

    override fun onDestroy() {
        super.onDestroy()
        stopStreamingAudio()

        if (::floatingView.isInitialized) {
            windowManager.removeView(floatingView)
        }
    }
}
