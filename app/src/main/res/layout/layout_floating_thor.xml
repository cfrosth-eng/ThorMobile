<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="120dp">

    <!-- Layer 1: The Orbiting Golden Ring (Background) -->
    <ImageView
        android:id="@+id/thor_glow_ring"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:src="@drawable/glow_ring"
        android:alpha="0.75"
        android:scaleType="centerCrop"
        android:contentDescription="Active Listening Glow" />

    <!-- Layer 2: Mjolnir Badge + Dual-Zone High-Voltage Lightning Overlays -->
    <androidx.cardview.widget.CardView
        android:id="@+id/thor_badge_card"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="center"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="35dp"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/thor_icon_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/image_5"
                android:scaleType="centerCrop"
                android:contentDescription="Thor Mjolnir Badge" />

            <ImageView
                android:id="@+id/thor_lightning_upper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.0"
                android:scaleType="centerCrop"
                android:contentDescription="Upper Lightning Bolts" />

            <ImageView
                android:id="@+id/thor_lightning_lower"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.0"
                android:scaleType="centerCrop"
                android:contentDescription="Lower Lightning Bolts" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
